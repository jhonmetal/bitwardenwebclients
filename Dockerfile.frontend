###############################################
# Frontend-only Dockerfile (serves static build with nginx)
###############################################
ARG NODE_VERSION=20
FROM node:${NODE_VERSION}-alpine AS node-build

WORKDIR /source
COPY package*.json ./
COPY . .
RUN npm ci --silent

WORKDIR /source/apps/web
ARG NPM_COMMAND=dist:bit:selfhost
RUN npm run ${NPM_COMMAND}

###############################################
# Serve with nginx
###############################################
FROM nginx:alpine
COPY --from=node-build /source/apps/web/build /usr/share/nginx/html
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh || true
EXPOSE 80
ENTRYPOINT ["/entrypoint.sh"]
